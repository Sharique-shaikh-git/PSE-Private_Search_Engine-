# Docker volumes (persistent data)
caddy_data/
caddy_config/
searxng-data/
valkey-data/

# Environment file (contains secret key)
.env

# SearXNG generated files
searxng/limiter.toml

# Tutorial transcript (not part of project)
transcript*

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Temporary files
tmp/
temp/
